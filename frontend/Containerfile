# Step 1: Base image
FROM docker.io/oven/bun:1 AS base
WORKDIR /app

# Step 2: Install dependencies
FROM base AS install
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

# Step 3: Build React static bundle
FROM base AS build
COPY --from=install /app/node_modules ./node_modules
COPY . .

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN bun run build

# Step 4: Final runner stage using Nginx
FROM docker.io/library/nginx:alpine AS runner

# Copy custom Nginx config for React Router fallback
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy build output (Vite builds to /dist by default)
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]